                  <label className="text-label-md font-label-md text-on-surface">City / Tehsils</label>
                  <input
                    className="h-11 px-3 bg-surface-container-low text-on-surface rounded focus:outline-none focus:ring-2 focus:ring-primary text-body-md font-body-md"
                    type="text"
                    value={formData.city}
                    onChange={(e) => updateFormData('city', e.target.value)}
                  />
                </div>
                <div className="flex flex-col gap-1.5">
                  <label className="text-label-md font-label-md text-on-surface">Postal PIN Code</label>
                  <input
                    className="h-11 px-3 bg-surface-container-low text-on-surface rounded focus:outline-none focus:ring-2 focus:ring-primary text-body-md font-body-md"
                    type="text"
                    value={formData.pincode}
                    onChange={(e) => updateFormData('pincode', e.target.value)}
                  />
                </div>
              </div>
              <div className="flex flex-col gap-1.5">
                <label className="text-label-md font-label-md text-on-surface">Zone / Micro-Market</label>
                <select
                  className="h-11 px-3 bg-surface-container-low text-on-surface rounded focus:outline-none focus:ring-2 focus:ring-primary text-body-md font-body-md"
                  value={formData.zone}
                  onChange={(e) => updateFormData('zone', e.target.value)}
                >
                  <option>Krishna Nagar / Township Corridor</option>
                  <option>NH-19 Expressway Hub</option>
                  <option>Vrindavan Parikrama Marg</option>
                  <option>Refinery Township Sector</option>
                </select>
              </div>
            </div>
            <div className="md:col-span-6">
              <div className="w-full h-56 rounded-xl bg-surface-container-high relative overflow-hidden flex flex-col justify-between p-3 border border-outline-variant/30" style={{backgroundImage: "url('https://lh3.googleusercontent.com/aida-public/AB6AXuDUdeCRF6zqVLti25jiY8Cq_KaRUS2uw1OkD9U5c_C6Ocw8o3C320fcav6E-qH5fkyyUIhTdPguQ5gzCbzZdUVuxnFr8ScjX9MyF5p7QSbFhqHWxyKvLNBp_jdLulYqJrAjtjZlHqugj319ryRTDoZmx1H-1ul5GMqDk21Oqx-RhHgwGFL2yaflBTmBtoXEyB85SJo3V0LJIhonjTl7svDZkTwp9HdqxBYAq-v9r_I')", backgroundSize: 'cover', backgroundPosition: 'center'}}>
                <div className="self-start px-2.5 py-1 rounded bg-surface/90 backdrop-blur text-label-sm font-label-sm text-on-surface font-semibold flex items-center gap-1 shadow-sm">
                  <span className="material-symbols-outlined text-[16px] text-primary">pin_drop</span>
                  <span>Cadastral Plot Verified</span>
                </div>
                <div className="self-end px-3 py-1 rounded bg-inverse-surface/85 text-inverse-on-surface text-label-sm font-label-sm backdrop-blur">
                  Click to refine precision marker
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* 6. MEDIA UPLOAD */}
        <div className="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm border border-outline-variant/30">
          <div className="flex items-center justify-between pb-space-sm mb-space-md">
            <div className="flex items-center gap-space-sm">
              <span className="w-7 h-7 rounded-full bg-surface-container-high text-on-surface flex items-center justify-center text-label-md font-label-md font-bold">6</span>
              <div>
                <h2 className="text-title-lg font-title-lg text-on-surface">High-Resolution Visual Assets &amp; Proofs</h2>
                <p className="text-body-sm font-body-sm text-secondary">Upload actual property photographs, layout floor plans, or factory warehouse inventory</p>
              </div>
            </div>
            <span className="text-label-sm font-label-sm text-secondary">Min 1080p • Max 25MB/file</span>
          </div>
          <div className="border-2 border-dashed border-outline-variant/60 rounded-xl p-space-lg text-center hover:bg-surface-container-low transition-colors cursor-pointer flex flex-col items-center justify-center">
            <div className="w-12 h-12 rounded-full bg-primary-fixed/30 text-primary flex items-center justify-center mb-space-sm">
              <span className="material-symbols-outlined text-[26px]">cloud_upload</span>
            </div>
            <p className="text-title-md font-title-md text-on-surface">Drag &amp; drop photos, floor plans, or inventory sheets</p>
            <p className="text-body-sm font-body-sm text-secondary mt-1">Supports JPG, PNG, WEBP, PDF for blueprints (Up to 15 files)</p>
            <button className="mt-space-md px-4 py-2 bg-surface text-on-surface rounded-lg text-label-md font-label-md shadow-sm hover:bg-surface-container transition-colors border border-outline-variant/40" type="button">
              Browse Computer
            </button>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-space-md mt-space-md">
            <div className="relative group rounded-xl overflow-hidden shadow-sm aspect-video bg-surface-container">
              <img className="w-full h-full object-cover" alt="A bright sunlit modern Indian living room with warm sandstone accent wall, marble flooring, and minimalist wooden furniture in Krishna Nagar Mathura." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBHeTjOdvTDX21Xjxxjco2S3nj_kfaCqhfmaSbWdqVZ7CoVKZTe1oOs72CewFlAyqYEpfBsAjOcOi3PtpBKGY1YaHysYs6X6oDpZ-Hn9DbpcCQ5ktAceycQnkOzWHagQPmsjsmbzrpbJgj-ER_EeFAxDAGeJkoaRkdmOw4v-QPlpUmXxP0nRNtsBqBLqfPtGjrflGtW3mA-XbsNqCJxBCTrV6YWD-rFrLLM8WkyEB0" />
              <span className="absolute top-2 left-2 bg-primary text-on-primary text-label-sm font-label-sm px-2 py-0.5 rounded-full font-semibold shadow">
                Cover Shot
              </span>
              <button className="absolute top-2 right-2 w-7 h-7 bg-inverse-surface/70 text-inverse-on-surface rounded-full flex items-center justify-center hover:bg-error transition-colors" type="button">
                <span className="material-symbols-outlined text-[16px]">close</span>
              </button>
            </div>
            <div className="relative group rounded-xl overflow-hidden shadow-sm aspect-video bg-surface-container">
              <img className="w-full h-full object-cover" alt="A spacious master bedroom interior with warm neutral architectural plaster walls, large glass balcony window overlooking lush green trees, and sleek lighting." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDp6naZ4UupMmlvvWqUeSOmKK0uxYktk7sZ8mhb8T12ecE-yG789lKx9VQhYeNb-UvRaeU5vW_dSaLRDbZ6S0DsvIfwsMAFoX12OET2M0gOJorfzqoGOsGJ8C4L_lDvPR6vGO-J-WymJaeBJYYdOk82K7WC7kToYv_s8Rr_LhBr9Q6sdtDX_4ihg4SMfEmIJ-8cs4ZjJjoADd0-CVWzREYI3U3lDQX9K0riBX5tAJc" />
              <span className="absolute bottom-2 left-2 bg-inverse-surface/75 text-inverse-on-surface text-label-sm font-label-sm px-2 py-0.5 rounded">
                Master Suite
              </span>
              <button className="absolute top-2 right-2 w-7 h-7 bg-inverse-surface/70 text-inverse-on-surface rounded-full flex items-center justify-center hover:bg-error transition-colors" type="button">
                <span className="material-symbols-outlined text-[16px]">close</span>
              </button>
            </div>
            <div className="relative group rounded-xl overflow-hidden shadow-sm aspect-video bg-surface-container">
              <img className="w-full h-full object-cover" alt="Architectural 2D detailed layout blueprint drawing showing room dimensions in square feet with clean vector lines on off-white paper." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAs5_QTyvh6ZnT8Ro9F86uL5QgZrtq_r7KVQyq8eD0KQ5jXNmJw2XlytiMzsRZhC2yhVJR8gccIN_5f47LVIJYWVrzcE--dokllhjNalzV6QRkbNCNRyNYNLGdw3EcxNmIYAkhR_goS8IvoSmAMobzRJP8U5opmXlUkUkCh8nV9PyRPyqaB_3C2HVKFaIp480UML-wlGZDT-CaKR4Z6r7pez_aguk71qzoPID40lrg" />
              <span className="absolute bottom-2 left-2 bg-inverse-surface/75 text-inverse-on-surface text-label-sm font-label-sm px-2 py-0.5 rounded">
                Floor Plan (2D)
              </span>
              <button className="absolute top-2 right-2 w-7 h-7 bg-inverse-surface/70 text-inverse-on-surface rounded-full flex items-center justify-center hover:bg-error transition-colors" type="button">
                <span className="material-symbols-outlined text-[16px]">close</span>
              </button>
            </div>
            <div className="relative group rounded-xl overflow-hidden shadow-sm aspect-video bg-surface-container">
              <img className="w-full h-full object-cover" alt="Exterior view of a newly constructed contemporary residential residential complex in Uttar Pradesh with terracotta terracotta tiles and modern balconies under clear sky." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDPL1TvYWZ0FtunaAnzsat9FD0nOUs4ZxlUDaGwc29KCVftSrveR3Lom3KJGkVFEDiMe549wRF7zwgw6L42EGZ3-hQQnzlI1FoL3PTEUYZOCnF1AMbfYrbSZLYJXCWr0SV4O5A0AyN3yNVi4zkNvCiZqaOiF0Gv0NMHKd0ebf-XLh6rdRQAfKXNx0ps1aT7WSnpo421V8saIynDh_sc0k1I-awLnV6rLi-DB-EAEyY" />
              <span className="absolute bottom-2 left-2 bg-inverse-surface/75 text-inverse-on-surface text-label-sm font-label-sm px-2 py-0.5 rounded">
                Building Exterior
              </span>
              <button className="absolute top-2 right-2 w-7 h-7 bg-inverse-surface/70 text-inverse-on-surface rounded-full flex items-center justify-center hover:bg-error transition-colors" type="button">
                <span className="material-symbols-outlined text-[16px]">close</span>
              </button>
            </div>
          </div>
        </div>

        {/* TRUST SHIELD BANNER */}
        <div className="p-space-lg rounded-xl bg-primary-fixed/20 border border-primary-fixed-dim/40 flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
          <div className="flex items-start gap-space-md">
            <div className="w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center flex-shrink-0">
              <span className="material-symbols-outlined text-[22px]">privacy_tip</span>
            </div>
            <div>
              <h4 className="text-title-md font-title-md text-on-surface">GharBazaar Centralized Privacy &amp; Anti-Spam Shield Active</h4>
              <p className="text-body-sm font-body-sm text-secondary mt-0.5">
                Your personal mobile number (+91 98391 22840) is completely shielded from public discovery. Qualified buyer calls, tenant visits, and wholesale material inquiries are strictly pre-screened via our Mathura Trust Desk.
              </p>
            </div>
          </div>
          <div className="flex items-center gap-space-xs text-label-sm font-label-sm text-primary font-semibold whitespace-nowrap bg-surface-container-lowest px-3 py-1.5 rounded-lg border border-outline-variant/30">
            <span className="material-symbols-outlined text-[18px]">verified</span>
            <span>Deal Assist Desk Protected</span>
          </div>
        </div>
      </form>

      {/* FIXED BOTTOM ACTION BAR */}
      <div className="fixed bottom-0 left-0 right-0 bg-surface-container-lowest/95 backdrop-blur-md shadow-lg p-space-md z-30 border-t border-outline-variant/30">
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-space-md">
          <div className="flex items-center gap-space-sm">
            <span className="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
            <div className="text-label-sm font-label-sm text-secondary">
              <span>Draft synchronized: <strong>
                {currentChannel === 'sell' && 'Krishna Nagar Penthouse (Draft #402)'}
                {currentChannel === 'rent' && '2BHK Krishna Nagar Rental (Draft #781)'}
                {currentChannel === 'products' && 'UltraTech Super 53 SKU (Draft #912)'}
              </strong></span>
              <span className="hidden md:inline text-outline">• Saved just now</span>
            </div>
          </div>
          <div className="flex items-center gap-space-md w-full sm:w-auto justify-end">
            <button className="px-4 py-2.5 rounded-lg bg-surface hover:bg-surface-container text-on-surface text-label-md font-label-md transition-colors shadow-sm border border-outline-variant/30" type="button">
              Save as Draft
            </button>
            <button className="px-4 py-2.5 rounded-lg bg-surface hover:bg-surface-container text-on-surface text-label-md font-label-md transition-colors shadow-sm flex items-center gap-1.5 border border-outline-variant/30" type="button">
              <span className="material-symbols-outlined text-[18px]">visibility</span>
              <span>Preview</span>
            </button>
            <button className="px-6 py-2.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary text-label-md font-label-md transition-all shadow-md flex items-center gap-2" onClick={triggerPublishSuccess} type="button">
              <span className="material-symbols-outlined text-[18px]">check_circle</span>
              <span>
                {currentChannel === 'sell' && 'Publish • Pay Standard (₹1,414.82 Incl. GST)'}
                {currentChannel === 'rent' && 'Publish Rental • Standard Mgmt (10% Comm.)'}
                {currentChannel === 'products' && 'List Catalog SKU • 5% Platform Model'}
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
